@model RewardDeleteVm
@using HRMS.Web.Services
@{ViewData["Title"]="Xác nhận xóa mềm";}
<div class="card card-body"><h1>Xác nhận xóa mềm</h1><p>Quyết định <strong>@Model.Decision.SOQUYETDINH</strong> · @RewardTypes.Label(Model.Decision.LOAI) · Nhân viên @(Model.Decision.MANV?.ToString()??"Chưa có mã") – @DisplayText.Value(Model.Decision.Employee?.HOTEN).</p>
<p>Quyết định sẽ được ẩn khỏi danh sách mặc định và vẫn có thể xem lại khi bật xem bản ghi đã xóa.</p>
<form method="post" asp-action="Delete"><div asp-validation-summary="All" class="alert alert-danger"></div><input asp-for="Number" type="hidden" /><input asp-for="Version" type="hidden" /><button class="btn btn-danger" type="submit" disabled="@RewardDecisionService.Deleted(Model.Decision)">Xác nhận xóa mềm</button> <a class="btn btn-outline-secondary" asp-action="Details" asp-route-number="@Model.Decision.SOQUYETDINH">Hủy</a></form></div>
