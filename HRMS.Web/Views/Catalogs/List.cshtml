@model CatalogListVm
@{ViewData["Title"]=Model.Title;}
<div class="page-heading"><div><h1>@Model.Title</h1><p>@Model.Total kết quả / @Model.AllCount bản ghi trong danh mục</p></div><a class="btn btn-outline-secondary" asp-action="Index">Tất cả danh mục</a></div>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<form method="get" class="card card-body mb-3"><input type="hidden" asp-for="Kind" /><div class="row g-2 align-items-end"><div class="col-sm-8"><label asp-for="Search" class="form-label">Tìm theo mã hoặc tên</label><input asp-for="Search" class="form-control" maxlength="100" /></div><div class="col-sm-4"><button type="submit" class="btn btn-primary">Tìm kiếm</button> <a class="btn btn-outline-secondary" asp-action="List" asp-route-kind="@Model.Kind">Xóa lọc</a></div></div></form>
@if(Model.Rows.Count==0 && ViewData.ModelState.IsValid) {<div class="card card-body">@(Model.AllCount==0?"Danh mục chưa có dữ liệu.":"Không có kết quả phù hợp.")</div>}
else if(Model.Kind=="companies" && Model.AllCount==1 && Model.Rows.Count==1) {
<div class="card card-body"><partial name="_RowDetails" model="@(new CatalogDetailVm(CatalogDefinitions.Find(Model.Kind)!,Model.Rows[0]))" /><div class="mt-3"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-kind="@Model.Kind" asp-route-id="@Model.Rows[0].Id">Xem nhân viên</a></div></div>
} else if(Model.Rows.Count>0) {
<div class="card"><div class="table-responsive" tabindex="0" role="region" aria-label="Danh sách danh mục"><table class="table mb-0"><thead><tr><th>Mã</th><th>Tên</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var row in Model.Rows) {<tr><td>@row.Id</td><td class="long-text">@DisplayText.Value(row.Name)</td><td><a asp-action="Details" asp-route-kind="@Model.Kind" asp-route-id="@row.Id">Xem chi tiết</a></td></tr>}
</tbody></table></div></div>
}
@if(Model.Pages>1) {<nav class="d-flex gap-2 align-items-center mt-3" aria-label="Phân trang danh mục">@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-action="List" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)">Trước</a>}<span>Trang @Model.Page / @Model.Pages</span>@if(Model.Page<Model.Pages){<a class="btn btn-outline-secondary" asp-action="List" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)">Sau</a>}</nav>}
