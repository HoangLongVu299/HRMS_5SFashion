@model CatalogDetailVm
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Row.Name) ? Model.Definition.Title + " · #" + Model.Row.Id : Model.Row.Name;
    var filter = Model.Filter;
}
<div class="card card-body mb-3">
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted">@Model.Definition.Title · Mã @Model.Row.Id</p>
    <partial name="_RowDetails" model="Model" />
    <div class="mt-3"><a class="btn btn-outline-secondary" asp-action="List" asp-route-kind="@Model.Definition.Key">Về danh sách @Model.Definition.Title</a></div>
</div>
<section aria-labelledby="catalog-employees-heading">
    <div class="card card-body mb-3">
        <h2 id="catalog-employees-heading">Danh sách nhân viên</h2>
        <p class="text-muted">Danh sách theo thông tin đang lưu trên hồ sơ nhân viên. Tra cứu theo thời gian tại mục Tra cứu lịch sử công tác.</p>
        <p class="mb-0">Tổng số nhân viên liên quan: <strong>@Model.RelatedCount</strong> · Kết quả sau lọc: <strong>@Model.FilteredCount</strong></p>
    </div>
    <form method="get" asp-action="Details" class="card card-body mb-3">
        <input type="hidden" name="kind" value="@Model.Definition.Key" />
        <input type="hidden" name="id" value="@Model.Row.Id" />
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label for="employee-search" class="form-label">Tìm theo mã hoặc họ tên</label><input id="employee-search" name="search" value="@filter.Search" class="form-control" maxlength="100" /></div>
            <div class="col-md-3"><label for="employee-status" class="form-label">Trạng thái</label>
                <select id="employee-status" name="status" class="form-select">
                    <option value="all" selected="@(filter.Status == "all")">Tất cả</option>
                    <option value="working" selected="@(filter.Status == "working")">Đang làm việc</option>
                    <option value="left" selected="@(filter.Status == "left")">Đã thôi việc</option>
                    <option value="pending" selected="@(filter.Status == "pending")">Chờ tiếp nhận</option>
                    <option value="scheduled" selected="@(filter.Status == "scheduled")">Chờ vào làm</option>
                </select>
            </div>
            <div class="col-md-4 d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Tìm kiếm</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-kind="@Model.Definition.Key" asp-route-id="@Model.Row.Id">Bỏ bộ lọc</a></div>
        </div>
    </form>
    @if (Model.RelatedCount == 0) {
        <div class="card card-body" role="status">Danh mục chưa có nhân viên liên quan.</div>
    } else if (Model.FilteredCount == 0) {
        <div class="card card-body" role="status">Không có nhân viên phù hợp bộ lọc.</div>
    } else {
        <div class="card"><div class="table-responsive" tabindex="0" role="region" aria-label="Danh sách nhân viên liên quan">
            <table class="table mb-0"><thead><tr><th scope="col">Mã nhân viên</th><th scope="col">Họ tên</th><th scope="col">Phòng ban</th><th scope="col">Bộ phận</th><th scope="col">Chức vụ</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var employee in Model.Employees) {
                <tr><td>@employee.Id</td>
                    <td class="long-text"><a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id">@DisplayText.Value(employee.Name)</a></td>
                    <td>@DisplayText.Value(employee.Department)</td><td>@DisplayText.Value(employee.Section)</td><td>@DisplayText.Value(employee.Position)</td>
                    <td><span class="badge @DisplayText.EmploymentBadge(employee.EmploymentStatus ?? "unknown")">@employee.StatusLabel</span></td>
                    <td><a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id">Xem hồ sơ</a></td>
                </tr>
            }
            </tbody></table>
        </div></div>
        <nav class="d-flex flex-wrap gap-2 align-items-center mt-3" aria-label="Phân trang nhân viên">
            @if (filter.Page > 1) {
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-kind="@Model.Definition.Key" asp-route-id="@Model.Row.Id" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-page="@(filter.Page - 1)">Trước</a>
            }
            <span>Trang @filter.Page / @Model.Pages · 10 người/trang</span>
            @if (filter.Page < Model.Pages) {
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-kind="@Model.Definition.Key" asp-route-id="@Model.Row.Id" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-page="@(filter.Page + 1)">Sau</a>
            }
        </nav>
    }
</section>
