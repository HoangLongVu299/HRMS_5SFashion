@model EmployeeDetailsVm
@{ViewData["Title"]="Xác nhận xóa";}
<h1>Xác nhận xóa hồ sơ nhập nhầm</h1>
<div class="alert alert-warning">Chỉ được xóa hồ sơ không có dữ liệu liên quan. Hệ thống kiểm tra lại tại thời điểm xác nhận; không xóa dây chuyền và không chuyển trạng thái thôi việc.</div>
<div class="card card-body form-page"><p>Bạn muốn xóa vĩnh viễn hồ sơ <strong>#@Model.Employee.MANV — @DisplayText.Value(Model.Employee.HOTEN)</strong>?</p>
@if(Model.Periods.Count>0){<div class="alert alert-danger">Hồ sơ đã có @Model.Periods.Count đợt làm việc nên không thể xóa.</div>}
<form method="post" asp-action="Delete" asp-route-id="@Model.Employee.MANV" data-save-form>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="form-actions"><button class="btn btn-danger" type="submit" disabled="@(Model.Periods.Count>0)">Xác nhận xóa</button>
<a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Employee.MANV">Hủy</a>
<a class="btn btn-link" asp-action="Index">Quay lại danh sách</a>
</div></form></div>
