@model LoginViewModel
@{ Layout = "_LoginLayout"; ViewData["Title"] = "Đăng nhập hệ thống"; }
<main class="login-page"><div class="login-card">
<section class="login-form-panel" aria-labelledby="login-title">
<a class="login-brand" asp-controller="Account" asp-action="Login">5S FASHION<span>.</span></a>
<div class="avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg></div>
<h1 id="login-title">Đăng nhập hệ thống</h1><p class="description">Hệ thống quản lý nhân sự 5s Fashion</p>
@if (ViewData["SetupRequired"] is true) { <p class="setup-notice" role="status">Chưa thiết lập tài khoản demo. Chạy tiện ích <code>--setup-demo-account</code> theo hướng dẫn bàn giao trước khi đăng nhập.</p> }
<form asp-controller="Account" asp-action="Login" method="post">
<input asp-for="ReturnUrl" type="hidden" />
<div asp-validation-summary="All" class="validation" role="alert" aria-live="polite"></div>
<label asp-for="Username"></label><div class="input-wrap"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg><input asp-for="Username" type="text" autocomplete="username" maxlength="100" required aria-describedby="username-error" /></div><span asp-validation-for="Username" id="username-error" class="field-error"></span>
<label asp-for="Password"></label><div class="input-wrap"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg><input asp-for="Password" type="password" autocomplete="current-password" maxlength="256" required aria-describedby="password-error" /><button class="password-toggle" type="button" aria-controls="Password" aria-label="Hiện mật khẩu" aria-pressed="false" data-password-toggle>Hiện</button></div><span asp-validation-for="Password" id="password-error" class="field-error"></span>
<button type="submit" class="login-submit">Đăng nhập <span aria-hidden="true">→</span></button>
</form><p class="form-footer">Công ty cổ phần 5s Fashion</p>
</section>
<section class="welcome-panel" aria-labelledby="welcome-title"><div class="welcome-copy"><p class="welcome-eyebrow">5S FASHION · NHÂN SỰ</p><h2 id="welcome-title">Chào mừng<br />trở lại<span>.</span></h2><p>Quản lý hồ sơ và quá trình công tác nhân sự tại 5s Fashion.</p><div class="welcome-line" aria-hidden="true"></div></div><span class="welcome-foot">Hồ sơ · Công tác · Lịch sử</span></section>
</div></main>
